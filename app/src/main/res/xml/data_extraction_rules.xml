<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Explicit includes keep generated soundtrack files out of cloud and device transfer. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="emberfall_lyria_soundtrack/" />
    </device-transfer>
</data-extraction-rules>
